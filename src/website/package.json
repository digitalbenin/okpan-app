{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node ./node_modules/vite/bin/vite.js dev",
		"build": "yarn build:preview",
		"build:preview": "node ./node_modules/vite/bin/vite.js build",
		"build:static": "node ./scripts/build-static.mjs",
		"preview": "node ./node_modules/vite/bin/vite.js preview",
		"prepare": "node ./node_modules/@sveltejs/kit/svelte-kit.js sync || echo ''",
		"format": "node ./node_modules/prettier/bin/prettier.cjs --write .",
		"lint": "node ./node_modules/prettier/bin/prettier.cjs --check ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.0.0",
		"vite": "^7.0.4"
	},
	"dependencies": {
		"@tabler/icons-svelte": "^3.44.0",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.1",
		"fuse.js": "^7.1.0",
		"openseadragon": "^5.0.1",
		"sql.js": "^1.13.0",
		"sveltekit-search-params": "^4.0.0"
	}
}
