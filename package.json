{
  "name": "db-connection-tool-electron",
  "productName": "db-connection-tool-electron",
  "version": "1.0.0",
  "type": "module",
  "description": "My Electron application description",
  "main": ".vite/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "npm run build:sveltekit && electron-forge package",
    "make": "npm run build:sveltekit && electron-forge make",
    "publish": "npm run build:sveltekit && electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "dev:sveltekit": "vite dev",
    "build:sveltekit": "vite build",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node src/db/seed_from_json.js",
    "db:search-setup": "node src/db/scripts/applyMigration.js",
    "db:setup-all": "npm run db:push && npm run db:seed && npm run db:search-setup",
    "docs:schema": "node docs/scripts/generateSchema.js",
    "docs:generate": "npm run docs:schema && spectaql docs/spectaql.config.yml -t docs/dist"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.1",
    "@electron-forge/maker-deb": "^7.6.1",
    "@electron-forge/maker-rpm": "^7.6.1",
    "@electron-forge/maker-squirrel": "^7.6.1",
    "@electron-forge/maker-zip": "^7.6.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.1",
    "@electron-forge/plugin-fuses": "^7.6.1",
    "@electron-forge/plugin-vite": "^7.6.1",
    "@electron/fuses": "^1.8.0",
    "@libsql/client": "^0.14.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.21.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^20.11.17",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.4",
    "electron": "34.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "sass": "1.77.6",
    "svelte": "^5.20.1",
    "sveltekit-search-params": "^4.0.0-next.0",
    "vite": "^5.0.12"
  },
  "keywords": [],
  "author": {
    "name": "Calibro",
    "email": "hello@calib.ro"
  },
  "license": "MIT",
  "dependencies": {
    "@tanstack/table-core": "^8.21.2",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "drizzle-graphql": "^0.8.5",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "graphql": "^16.10.0",
    "graphql-tools": "^9.0.13",
    "melt": "^0.30.1",
    "sharp": "^0.33.5",
    "sveltekit-i18n": "^2.4.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "resolutions": {
    "graphql": "16.10.0"
  }
}
