{
  "source": {
    "include": [
      "src/backend",
      "src/db",
      "src/preload",
      "src/lib/utils"
    ],
    "exclude": [
      "src/db/queries",
      "src/db/graphqlDefs.js",
      "src/db/seed_from_json.js"
    ],
    "includePattern": "\\.js$"
  },
  "opts": {
    "template": "node_modules/docdash",
    "destination": "./docs/jsdoc",
    "recurse": true,
    "readme": "README.md"
  },
  "templates": {
    "default": {
      "useLongnameInNav": true,
      "staticFiles": {
        "include": [
          "docs/jsdoc-theme.css"
        ]
      }
    }
  },
  "docdash": {
    "static": false,
    "sort": true,
    "scripts": ["jsdoc-theme.css"],
    "sectionOrder": [
      "Namespaces",
      "Modules",
      "Classes",
      "Externals",
      "Events",
      "Interfaces",
      "Mixins",
      "Tutorials",
      "Global"
    ]
  },
  "tags": {
    "allowUnknownTags": true
  }
}
